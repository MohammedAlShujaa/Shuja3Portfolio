# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Used for local development and production.
# Neon / Vercel Postgres example:
#   postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Local Docker example (see README):
#   postgres://portfolio:portfolio@localhost:5432/portfolio
POSTGRES_URL=

# Plain password for the single admin account.
# The seed script hashes it with bcrypt and stores only the hash.
ADMIN_PASSWORD=

# Random string used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local port. Vercel sets this automatically in production.
PORT=3000

# Supabase Storage, used to upload modeling photos from the admin panel.
# Find these in your Supabase project under Settings, API.
#   SUPABASE_URL: the Project URL, for example https://abcd1234.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY: the service_role secret key. Keep it private.
#   SUPABASE_BUCKET: the name of a PUBLIC storage bucket you created (default photos).
# Leave these empty to disable in-admin photo upload (you can still paste image URLs).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos
